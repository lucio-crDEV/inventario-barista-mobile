{
  "name": "inventory-v3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local --env local",
    "seed:local": "node scripts/seed-local.mjs",
    "test": "node --test tests/*.test.mjs tests/shared/production-config.mjs",
    "test:integration": "node --test tests/shared/integration.mjs",
    "test:browser": "node tests/shared/browser.mjs",
    "test:load": "node tests/shared/load.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "dev:pages": "npm run build:pages && node scripts/dev-pages.mjs",
    "dev:pages:https": "npm run build:pages && node scripts/dev-pages.mjs --https",
    "test:pages": "node tests/shared/pages.mjs",
    "test:views": "node tests/shared/views.mjs",
    "test:prepare": "node scripts/prepare-tests.mjs",
    "test:server": "wrangler dev --env local --ip 127.0.0.1 --port 8790 --inspector-port 9232 --persist-to .wrangler/test-state --var APP_ORIGIN:http://127.0.0.1:8790",
    "test:pages:server": "node scripts/dev-pages.mjs --https --test",
    "test:extended": "node --test tests/shared/extended.mjs",
    "test:sync": "node tests/shared/sync.mjs",
    "test:ux": "node tests/shared/ux.mjs",
    "test:bootstrap": "python3 -m unittest discover -s tests -p '*_test.py'",
    "backup": "node scripts/backup.mjs",
    "restore:local": "node scripts/restore-local.mjs",
    "maintenance": "node scripts/maintenance.mjs",
    "test:operations": "node tests/shared/operations.mjs",
    "profile:local": "node scripts/profile-local.mjs",
    "verify:public": "node scripts/verify-public.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.28.2",
    "wrangler": "4.151.3"
  }
}
