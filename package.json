{
  "name": "inventory-v3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local --env local",
    "seed:local": "node scripts/seed-local.mjs",
    "test": "npm run lint:html && node --test tests/*.test.mjs tests/shared/production-config.mjs",
    "test:integration": "node --test tests/shared/integration.mjs",
    "test:browser": "node tests/shared/browser.mjs",
    "test:load": "node tests/shared/load.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "dev:pages": "npm run build:pages && node scripts/dev-pages.mjs",
    "dev:pages:https": "npm run build:pages && node scripts/dev-pages.mjs --https",
    "test:pages": "node tests/shared/pages.mjs",
    "test:views": "node tests/shared/views.mjs",
    "test:prepare": "node scripts/prepare-tests.mjs",
    "test:server": "wrangler dev --env local --ip 127.0.0.1 --port 8790 --inspector-port 9232 --persist-to .wrangler/test-state --var APP_ORIGIN:http://127.0.0.1:8790",
    "test:pages:server": "node scripts/dev-pages.mjs --https --test",
    "test:extended": "node --test tests/shared/extended.mjs",
    "test:users-service": "node --test tests/shared/users-service.mjs",
    "test:migration-service": "node tests/shared/migration-service.mjs",
    "test:users-service:browser": "node tests/shared/users-service-browser.mjs",
    "test:admin-layout": "node tests/shared/admin-layout.mjs",
    "test:sync": "node tests/shared/sync.mjs",
    "test:refresh": "node tests/shared/refresh.mjs",
    "test:ux": "node tests/shared/ux.mjs",
    "test:bootstrap": "python3 -m unittest discover -s tests -p '*_test.py'",
    "backup": "node scripts/backup.mjs",
    "restore:local": "node scripts/restore-local.mjs",
    "maintenance": "node scripts/maintenance.mjs",
    "test:operations": "node tests/shared/operations.mjs",
    "profile:local": "node scripts/profile-local.mjs",
    "verify:public": "node scripts/verify-public.mjs",
    "preflight": "node scripts/preflight.mjs",
    "test:security:isolated": "node scripts/test-security-isolated.mjs",
    "verify:excel-template": "python3 scripts/verify-excel-template.py",
    "export:local": "node scripts/export-excel.mjs",
    "test:export:runtime": "node tests/shared/excel-generator-runtime.mjs",
    "lint:html": "node scripts/lint-html.mjs",
    "format": "prettier --write \"worker/**/*.js\" \"shared/*.js\" \"pages/**/*.{js,css,html}\" \"operations/**/*.js\" \"scripts/**/*.mjs\" theme.js theme.css index.html",
    "format:check": "prettier --check \"worker/**/*.js\" \"shared/*.js\" \"pages/**/*.{js,css,html}\" \"operations/**/*.js\" \"scripts/**/*.mjs\" theme.js theme.css index.html",
    "resources:profile": "node tests/shared/free-capacity-profile.mjs",
    "test:resource-monitor": "node tests/shared/resource-monitor-runtime.mjs",
    "catalog:data": "node scripts/catalog-data.mjs",
    "test:login:core": "node tests/shared/password-concurrency-core.mjs",
    "test:login:runtime": "node tests/shared/password-concurrency-runtime.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "web-vitals": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "wrangler": "4.151.3"
  }
}
