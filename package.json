{
  "name": "inventory-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --env local",
    "db:local": "wrangler d1 migrations apply DB --local --env local",
    "seed:local": "node scripts/seed-local.mjs",
    "test": "node --test tests/*.test.mjs tests/shared/production-config.mjs",
    "test:integration": "node --test tests/shared/integration.mjs",
    "test:browser": "node tests/shared/browser.mjs",
    "test:load": "node tests/shared/load.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3"
  },
  "devDependencies": {
    "wrangler": "4.151.3",
    "@playwright/test": "1.56.1"
  }
}
