// Deploy separately before enabling the Pages EXPORTS namespace binding.
{
 "name":"inventory-exports",
 "main":"operations/export-worker/entry.js",
 "compatibility_date":"2026-10-01",
 "workers_dev":false,
 "preview_urls":false,
 "triggers":{"crons":["43 5 * * *"]},
 "d1_databases":[{"binding":"DB","database_name":"inventario-login-v3","database_id":"aff1d8f6-cde2-4ace-97b6-96f35ec0f8b0"}],
 "r2_buckets":[{"binding":"EXPORT_FILES","bucket_name":"inventario-exports"}],
 "durable_objects":{"bindings":[{"name":"PASSWORDS","class_name":"PasswordWork"},{"name":"EXPORTS","class_name":"InventoryExport"}]},
 "migrations":[{"tag":"exports-v1","new_sqlite_classes":["InventoryExport","PasswordWork"]}]
}
