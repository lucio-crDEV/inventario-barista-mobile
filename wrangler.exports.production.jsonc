// Deploy separately before enabling the Pages EXPORTS namespace binding.
{
  "name": "inventory-exports",
  "main": "operations/export-worker/entry.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/15 * * * *", "43 5 * * *"] },
  "vars": {
    "CF_ACCOUNT_ID": "5d7f98ff54c0a691173f3ec3cf29bff2",
    "APP_SCRIPT_NAME": "pages-worker--21988261-production",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1, "persist": true },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inventario-login-v3",
      "database_id": "aff1d8f6-cde2-4ace-97b6-96f35ec0f8b0",
    },
  ],
  "r2_buckets": [{ "binding": "EXPORT_FILES", "bucket_name": "inventario-exports" }],
  "durable_objects": {
    "bindings": [
      { "name": "PASSWORDS", "class_name": "PasswordWork" },
      { "name": "EXPORTS", "class_name": "InventoryExport" },
      { "name": "RESOURCES", "class_name": "ResourceMonitor" },
    ],
  },
  "migrations": [
    { "tag": "exports-v1", "new_sqlite_classes": ["InventoryExport", "PasswordWork"] },
    { "tag": "exports-v2-monitor", "new_sqlite_classes": ["ResourceMonitor"] },
  ],
}
