{
  "name": "inventario-login",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-01",
  "vars": {
    "APP_ENV": "production",
    "METRICS_ENABLED": "1",
    "APP_ORIGIN": "https://inventario-login.pages.dev",
    "ACTIVE_CYCLE_ID": "piloto-v3-servicio"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inventario-login-v3",
      "database_id": "aff1d8f6-cde2-4ace-97b6-96f35ec0f8b0",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "InventoryRealtime",
        "script_name": "inventory-realtime"
      }
    ]
  }
}
